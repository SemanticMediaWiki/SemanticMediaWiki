{
	"description": "Test `_mlt_rec` (Monolingual text) printout on a property chain with `|+lang`/`|+index` (#5477)",
	"setup": [
		{
			"namespace": "SMW_NS_PROPERTY",
			"page": "Has chain target",
			"contents": "[[Has type::Page]]"
		},
		{
			"namespace": "SMW_NS_PROPERTY",
			"page": "Has mlt name",
			"contents": "[[Has type::Monolingual text]]"
		},
		{
			"page": "Example/P5477/Target",
			"contents": "[[Has mlt name::Englishvalue@en]] [[Has mlt name::Germanvalue@de]]"
		},
		{
			"page": "Example/P5477/Source",
			"contents": "[[Has chain target::Example/P5477/Target]]"
		},
		{
			"page": "Example/P5477/Q.0",
			"contents": "{{#ask:[[Has chain target::Example/P5477/Target]]|?Has chain target.Has mlt name|+lang=de|mainlabel=-|format=table}}"
		},
		{
			"page": "Example/P5477/Q.1",
			"contents": "{{#ask:[[Has chain target::Example/P5477/Target]]|?Has chain target.Has mlt name|+index=1|mainlabel=-|format=table}}"
		},
		{
			"page": "Example/P5477/Q.2",
			"contents": "{{#ask:[[Has chain target::Example/P5477/Target]]|?Has chain target.Has mlt name|mainlabel=-|format=table}}"
		}
	],
	"tests": [
		{
			"type": "parser",
			"about": "#0 chained printout filtered by `|+lang`",
			"subject": "Example/P5477/Q.0",
			"assert-output": {
				"to-contain": [
					"Germanvalue"
				],
				"not-contain": [
					"Englishvalue"
				]
			}
		},
		{
			"type": "parser",
			"about": "#1 chained printout addressed by `|+index`",
			"subject": "Example/P5477/Q.1",
			"assert-output": {
				"to-contain": [
					"Englishvalue",
					"Germanvalue"
				],
				"not-contain": [
					"(en)"
				]
			}
		},
		{
			"type": "parser",
			"about": "#2 chained printout without a parameter keeps the language tags",
			"subject": "Example/P5477/Q.2",
			"assert-output": {
				"to-contain": [
					"Englishvalue (en)",
					"Germanvalue (de)"
				]
			}
		}
	],
	"settings": {
		"wgContLang": "en",
		"wgLang": "en",
		"smwgNamespacesWithSemanticLinks": {
			"NS_MAIN": true,
			"SMW_NS_PROPERTY": true
		}
	},
	"meta": {
		"version": "2",
		"is-incomplete": false,
		"debug": false
	}
}
