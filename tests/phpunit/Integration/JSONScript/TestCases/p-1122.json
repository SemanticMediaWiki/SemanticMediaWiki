{
	"description": "Test #ask short captions omit the namespace prefix of a DISPLAYTITLE (#7073, `wgContLang=en`, `wgLang=en`, `wgRestrictDisplayTitle=false`)",
	"setup": [
		{
			"namespace": "NS_HELP",
			"page": "P1122 Foo",
			"contents": "[[Category:P1122]]"
		},
		{
			"namespace": "NS_HELP",
			"page": "P1122 Bar",
			"contents": "{{DISPLAYTITLE:Help:P1122 Bar (inactive)}} [[Category:P1122]]"
		},
		{
			"page": "Example/P1122/Q.1",
			"contents": "{{#ask: [[Category:P1122]] |format=ul }}"
		},
		{
			"page": "Example/P1122/Q.2",
			"contents": "{{#ask: [[Category:P1122]] |format=ul |prefix=none }}"
		},
		{
			"page": "Example/P1122/Q.3",
			"contents": "{{#ask: [[Category:P1122]] |format=ul |prefix=all }}"
		}
	],
	"tests": [
		{
			"type": "parser",
			"about": "#0 (default, namespace is omitted from the display title)",
			"subject": "Example/P1122/Q.1",
			"assert-output": {
				"to-contain": [
					"title=\"Help:P1122 Bar\">P1122 Bar (inactive)</a>",
					"title=\"Help:P1122 Foo\">P1122 Foo</a>"
				],
				"not-contain": [
					">Help:P1122 Bar (inactive)</a>"
				]
			}
		},
		{
			"type": "parser",
			"about": "#1 (prefix=none)",
			"subject": "Example/P1122/Q.2",
			"assert-output": {
				"to-contain": [
					"title=\"Help:P1122 Bar\">P1122 Bar (inactive)</a>"
				],
				"not-contain": [
					">Help:P1122 Bar (inactive)</a>"
				]
			}
		},
		{
			"type": "parser",
			"about": "#2 (prefix=all keeps the display title as is)",
			"subject": "Example/P1122/Q.3",
			"assert-output": {
				"to-contain": [
					"title=\"Help:P1122 Bar\">Help:P1122 Bar (inactive)</a>"
				]
			}
		}
	],
	"settings": {
		"wgContLang": "en",
		"wgLang": "en",
		"wgRestrictDisplayTitle": false
	},
	"meta": {
		"version": "2",
		"is-incomplete": false,
		"debug": false
	}
}
